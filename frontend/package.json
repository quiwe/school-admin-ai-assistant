    "generate:icons": "python3 tools/generate_icons.py && python3 tools/generate_round_icons.py"
  },
  "dependencies": {
    "@capacitor/core": "^8.3.4",
    "@vitejs/plugin-react": "^4.5.2",
    "lucide-react": "^0.469.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.3",
    "typescript": "^5.7.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@capacitor/android": "^8.3.4",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.3.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17"
  }
